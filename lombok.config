lombok.log.custom.declaration=dev.breezes.settlements.shared.logging.ILogger dev.breezes.settlements.shared.logging.LoggerFactory.getLogger(NAME)

# Copy Dagger @Qualifier annotations from an injected field onto the Lombok-generated constructor
# parameter, so qualified DI (e.g. the executor pools in ConcurrencyModule) resolves to the right
# binding. Without this the qualifier is silently dropped and the wrong binding is injected.
lombok.copyableAnnotations += dev.breezes.settlements.di.PlanGenerationExecutor
lombok.copyableAnnotations += dev.breezes.settlements.di.WorldScanExecutor
lombok.copyableAnnotations += dev.breezes.settlements.di.DataReloadListeners
lombok.copyableAnnotations += dev.breezes.settlements.di.PostReloadListeners

# Insurance against the SIS kill-switch qualified-set pattern (SensorCatalogModule /
# SocialCueCatalogModule): every consumer is designed to inject the unqualified effective set, so
# nothing should ever @Inject a @CognitionScoped/@BaseLane dependency directly -- but if one ever
# does via a Lombok-generated constructor, this keeps the qualifier from being silently dropped.
lombok.copyableAnnotations += dev.breezes.settlements.di.CognitionScoped
lombok.copyableAnnotations += dev.breezes.settlements.di.BaseLane
